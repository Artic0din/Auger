{
  "name": "auger",
  "private": true,
  "type": "module",
  "description": "Third-party Silo client for Samsung Tizen TVs",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.test.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test:native": "node --test --test-timeout=15000 \"test/native/*.test.ts\"",
    "test": "npm run build && npm run test:native && npm run test:ui",
    "sync:translations": "node scripts/sync-translations.ts",
    "test:ui": "node scripts/run-ui-tests.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "unicode-segmenter": "0.17.3",
    "uqr": "0.1.3"
  }
}
